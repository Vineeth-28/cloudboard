# Copy this file to .env for local development:
#   cp .env.example .env
#
# NEVER commit a real .env file - it is already covered by the root .gitignore.

# Environment: development | production | test
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# MongoDB connection string.
# Local dev (docker compose):   mongodb://mongo:27017/cloudboard
# Local dev (host machine):     mongodb://localhost:27017/cloudboard
# Production: injected via Kubernetes Secret, never hardcoded here.
MONGO_URI=mongodb://localhost:27017/cloudboard

# Log verbosity: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Allowed CORS origin for the frontend. Use a specific origin in production,
# never "*", once real domains are known.
CORS_ORIGIN=*

# How long (ms) the server waits for in-flight requests to finish
# before forcing an exit during graceful shutdown.
SHUTDOWN_TIMEOUT_MS=10000
